generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["partialIndexes"]
}

datasource db {
  provider = "postgresql"
}

model acc_schedule_line {
  id                   Int               @id @default(autoincrement())
  acc_schedule_name_id Int
  line_no              Int               @default(0)
  row_no               String            @default("")
  description          String            @default("")
  totaling_type        String            @default("POSTING_ACCOUNTS")
  totaling             String            @default("")
  amount_type          String            @default("NET_AMOUNT")
  row_type             String            @default("NET_CHANGE")
  show                 String            @default("YES")
  bold                 Int               @default(0)
  italic               Int               @default(0)
  underline            Int               @default(0)
  double_underline     Int               @default(0)
  show_opposite_sign   Int               @default(0)
  new_page             Int               @default(0)
  indentation          Int               @default(0)
  dimension_1_totaling String            @default("")
  dimension_2_totaling String            @default("")
  created_at           String?
  created_by           String?
  acc_schedule_name    acc_schedule_name @relation(fields: [acc_schedule_name_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([acc_schedule_name_id], map: "ix_acc_schedule_line_name")
}

model acc_schedule_name {
  id                         Int                 @id @default(autoincrement())
  name                       String              @unique
  description                String              @default("")
  default_column_layout_name String?
  created_at                 String?
  created_by                 String?
  acc_schedule_line          acc_schedule_line[]
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model accounting_period {
  id              Int    @id @default(autoincrement())
  code            String @unique
  start_date      String
  end_date        String
  status          String @default("OPEN")
  new_fiscal_year Int    @default(0)
  fiscally_closed Int    @default(0)
  date_locked     Int    @default(0)
}

model app_user {
  id                         Int                          @id @default(autoincrement())
  username                   String                       @unique
  full_name                  String
  email                      String?
  phone                      String?
  password_hash              String
  role_id                    Int
  status                     String                       @default("ACTIVE")
  last_login_at              String?
  created_at                 String?
  work_date                  String?
  active_profile_id          Int?
  signature_image            String?
  company_code               String?
  failed_logins              Int                          @default(0)
  locked_until               String?
  must_change_password       Boolean                      @default(false)
  password_changed_at        String?
  totp_secret                String?
  totp_enabled               Boolean                      @default(false)
  totp_enrolled_at           String?
  totp_recovery_codes        String?
  totp_last_step             BigInt?
  profile                    profile?                     @relation(fields: [active_profile_id], references: [id], onUpdate: NoAction)
  role                       role                         @relation(fields: [role_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  approval_user_setup        approval_user_setup?
  session                    session[]
  user_permission_line       user_permission_line[]
  user_permission_set        user_permission_set[]
  user_profile               user_profile[]
  workflow_user_group_member workflow_user_group_member[]

  @@index([role_id], map: "ix_user_role")
}

model approval_user_setup {
  id                        Int       @id @default(autoincrement())
  user_id                   Int       @unique
  approver_id               Int?
  substitute_id             Int?
  is_approval_administrator Int       @default(0)
  can_reverse_journal       Int       @default(0)
  allow_posting_from        String?
  allow_posting_to          String?
  allow_posting_from_time   String?
  allow_posting_to_time     String?
  employee_id               Int?      @unique(map: "ux_approval_user_setup_employee")
  employee                  employee? @relation(fields: [employee_id], references: [id], onUpdate: NoAction)
  app_user                  app_user  @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([is_approval_administrator], map: "ix_approval_admin")
}

model attachment {
  id            Int     @id @default(autoincrement())
  entity        String
  entity_id     Int
  public_id     String  @unique
  url           String
  filename      String
  resource_type String  @default("image")
  format        String?
  bytes         Int     @default(0)
  category      String?
  uploaded_at   String
  uploaded_by   String

  @@index([entity, entity_id, id(sort: Desc)], map: "ix_attachment_entity")
}

model audit_log {
  id        Int     @id @default(autoincrement())
  at        String
  user_id   Int?
  username  String?
  action    String
  entity    String?
  entity_id String?
  detail    String?
  ip        String?

  @@index([at(sort: Desc)], map: "ix_audit_at")
}

model bank_acc_posting_group {
  id            Int        @id @default(autoincrement())
  code          String     @unique
  description   String
  gl_account_id Int
  created_at    String?
  created_by    String?
  gl_account    gl_account @relation(fields: [gl_account_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "bapg_gl_account_fkey")
}

model bank_account {
  id                                                                          Int                         @id @default(autoincrement())
  code                                                                        String                      @unique
  name                                                                        String
  gl_account_id                                                               Int                         @unique
  bank_name                                                                   String?
  account_no                                                                  String?
  balance                                                                     BigInt                      @default(0)
  status                                                                      String                      @default("ACTIVE")
  created_at                                                                  String?
  account_type                                                                String                      @default("OTHER")
  currency_code                                                               String                      @default("KES")
  balance_lcy                                                                 BigInt                      @default(0)
  bank_acc_posting_group_code                                                 String?
  bank_branch_no                                                              String?
  bank_sort_code                                                              String?
  external_bank_code                                                          String?
  iban                                                                        String?
  swift_code                                                                  String?
  min_balance                                                                 BigInt                      @default(0)
  last_statement_no                                                           Int                         @default(0)
  balance_last_statement                                                      BigInt                      @default(0)
  blocked                                                                     Int                         @default(0)
  gl_account                                                                  gl_account                  @relation(fields: [gl_account_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  bank_account_ledger_entry                                                   bank_account_ledger_entry[]
  bank_reconciliation                                                         bank_reconciliation[]
  cash_management_setup                                                       cash_management_setup[]
  cash_office_transfer_cash_office_transfer_destination_bank_account_idTobank_account cash_office_transfer[]          @relation("cash_office_transfer_destination_bank_account_idTobank_account")
  cash_office_transfer_cash_office_transfer_source_bank_account_idTobank_account      cash_office_transfer[]          @relation("cash_office_transfer_source_bank_account_idTobank_account")
  imprest_request_imprest_request_claim_paying_bank_account_idTobank_account  imprest_request[]           @relation("imprest_request_claim_paying_bank_account_idTobank_account")
  imprest_request_imprest_request_paying_bank_account_idTobank_account        imprest_request[]           @relation("imprest_request_paying_bank_account_idTobank_account")
  imprest_request_imprest_request_receiving_bank_account_idTobank_account     imprest_request[]           @relation("imprest_request_receiving_bank_account_idTobank_account")
  payment_voucher_header                                                      payment_voucher_header[]
  petty_cash                                                                  petty_cash[]
  posted_payment_voucher                                                      posted_payment_voucher[]
  posted_receipt                                                              posted_receipt[]
  receipt_header                                                              receipt_header[]
  staff_claim                                                                 staff_claim[]
  cashier_setup                                                                cashier_setup[]
  till_closing_till_closing_till_bank_account_idTobank_account                till_closing[]              @relation("till_closing_till_bank_account_idTobank_account")
  till_closing_till_closing_treasury_bank_account_idTobank_account            till_closing[]              @relation("till_closing_treasury_bank_account_idTobank_account")
}

model bank_account_ledger_entry {
  id                     Int                  @id @default(autoincrement())
  bank_account_id        Int
  journal_id             Int
  journal_line_id        Int
  posting_date           String
  description            String?
  amount                 BigInt
  running_balance        BigInt
  reconciled             Int                  @default(0)
  bank_reconciliation_id Int?
  created_at             String?
  currency_code          String               @default("KES")
  currency_factor        Float                @default(1)
  amount_lcy             BigInt               @default(0)
  document_type          String               @default("")
  document_no            String?
  external_document_no   String?
  open                   Int                  @default(1)
  statement_no           String?
  statement_line_no      Int?
  reversed               Int                  @default(0)
  bank_account           bank_account         @relation(fields: [bank_account_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  bank_reconciliation    bank_reconciliation? @relation(fields: [bank_reconciliation_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  journal                journal              @relation(fields: [journal_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  journal_line           journal_line         @relation(fields: [journal_line_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  bank_rec_line          bank_rec_line[]

  @@index([bank_account_id], map: "ix_bale_account")
  @@index([journal_id], map: "ix_bale_journal")
  @@index([bank_reconciliation_id], map: "ix_bale_reconciliation")
}

model bank_rec_line {
  id                           Int                        @id @default(autoincrement())
  bank_reconciliation_id       Int
  line_no                      Int
  type                         String                     @default("Bank Account Ledger Entry")
  transaction_date             String?
  document_no                  String?
  description                  String?
  statement_amount             BigInt                     @default(0)
  applied_amount               BigInt                     @default(0)
  bank_account_ledger_entry_id Int?
  gl_account_id                Int?
  applied                      Int                        @default(0)
  bank_account_ledger_entry    bank_account_ledger_entry? @relation(fields: [bank_account_ledger_entry_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "brl_bale_fkey")
  gl_account                   gl_account?                @relation(fields: [gl_account_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "brl_gl_account_fkey")
  bank_reconciliation          bank_reconciliation        @relation(fields: [bank_reconciliation_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "brl_recon_fkey")

  @@unique([bank_reconciliation_id, line_no], map: "bank_rec_line_recon_lineno_key")
}

model bank_reconciliation {
  id                        Int                         @id @default(autoincrement())
  bank_account_id           Int
  statement_date            String
  statement_balance         BigInt
  status                    String                      @default("OPEN")
  created_by                String?
  created_at                String?
  completed_by              String?
  completed_at              String?
  statement_no              String?
  balance_last_statement    BigInt                      @default(0)
  posted                    Boolean                     @default(false)
  posted_by                 String?
  posted_at                 String?
  journal_id                Int?
  bank_account_ledger_entry bank_account_ledger_entry[]
  bank_rec_line             bank_rec_line[]
  bank_account              bank_account                @relation(fields: [bank_account_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([bank_account_id], map: "ix_brec_account")
}

model cash_denomination_line {
  id              Int          @id @default(autoincrement())
  document_kind   String
  document_no     String
  denomination_id Int
  quantity        Int          @default(0)
  denomination    denomination @relation(fields: [denomination_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([document_kind, document_no, denomination_id], map: "cash_denomination_line_document_kind_document_no_denominatio_ke")
  @@index([document_kind, document_no], map: "ix_cdl_document")
}

model cash_management_setup {
  id                                                                           Int           @id @default(1)
  receipt_approval_limit                                                       BigInt        @default(0)
  pv_approval_limit                                                            BigInt        @default(0)
  bank_charges_account_id                                                      Int?
  bank_interest_income_account_id                                              Int?
  default_receipt_bank_account_id                                              Int?
  allow_cm_posting_from                                                        String?
  allow_cm_posting_to                                                          String?
  updated_at                                                                   String?
  updated_by                                                                   String?
  default_vat_bus_posting_group_code                                           String?
  gl_account_cash_management_setup_bank_charges_account_idTogl_account         gl_account?   @relation("cash_management_setup_bank_charges_account_idTogl_account", fields: [bank_charges_account_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "cms_bank_charges_fkey")
  gl_account_cash_management_setup_bank_interest_income_account_idTogl_account gl_account?   @relation("cash_management_setup_bank_interest_income_account_idTogl_account", fields: [bank_interest_income_account_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "cms_bank_interest_fkey")
  bank_account                                                                 bank_account? @relation(fields: [default_receipt_bank_account_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "cms_default_bank_fkey")
}

model change_log_entry {
  id            Int     @id @default(autoincrement())
  table_name    String
  table_caption String
  record_id     String
  field_name    String
  old_value     String?
  new_value     String?
  type          String
  changed_at    String
  user_id       Int?
  username      String

  @@index([changed_at(sort: Desc)], map: "ix_change_log_entry_at")
  @@index([table_name, record_id], map: "ix_change_log_entry_record")
}

model change_log_setup {
  table_name       String @id
  table_caption    String
  log_insertion    Int    @default(0)
  log_modification Int    @default(0)
  log_deletion     Int    @default(0)
}

model column_layout {
  id                      Int                @id @default(autoincrement())
  column_layout_name_id   Int
  line_no                 Int                @default(0)
  column_no               String             @default("")
  column_header           String             @default("")
  column_type             String             @default("NET_CHANGE")
  ledger_entry_type       String             @default("ENTRIES")
  amount_type             String             @default("NET_AMOUNT")
  formula                 String             @default("")
  comparison_date_formula String             @default("")
  show                    String             @default("ALWAYS")
  rounding_factor         String             @default("NONE")
  created_at              String?
  created_by              String?
  budget_name             String?
  column_layout_name      column_layout_name @relation(fields: [column_layout_name_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([column_layout_name_id], map: "ix_column_layout_name")
}

model column_layout_name {
  id            Int             @id @default(autoincrement())
  name          String          @unique
  description   String          @default("")
  created_at    String?
  created_by    String?
  column_layout column_layout[]
}

/// This model contains an expression index which requires additional setup for migrations. Visit https://pris.ly/d/expression-indexes for more info.
model company {
  id           Int     @id @default(autoincrement())
  code         String
  schema_name  String  @unique(map: "ux_company_schema")
  display_name String
  is_default   Boolean @default(false)
  copied_from  String?
  created_at   String
  created_by   String?
}

model company_job {
  id                         Int                          @id @default(autoincrement())
  job_id                     String                       @unique
  name                       String
  objective                  String?
  reports_to_job_id          Int?
  job_grade_id               Int?
  global_dimension_1_id      Int?
  global_dimension_2_id      Int?
  no_of_posts                Int                          @default(1)
  is_management              Boolean                      @default(false)
  profession                 String?
  skills_category            String?
  skills_category_2          String?
  skills_category_3          String?
  status                     String                       @default("Open")
  decision_reason            String?
  created_at                 String?
  created_by                 String?
  approved_at                String?
  approved_by                String?
  global_dimension_1_value   global_dimension_1_value?    @relation(fields: [global_dimension_1_id], references: [id], onUpdate: NoAction, map: "cj_gd1_fkey")
  global_dimension_2_value   global_dimension_2_value?    @relation(fields: [global_dimension_2_id], references: [id], onUpdate: NoAction, map: "cj_gd2_fkey")
  hr_job_grade               hr_job_grade?                @relation(fields: [job_grade_id], references: [id], onUpdate: NoAction, map: "cj_job_grade_fkey")
  company_job                company_job?                 @relation("company_jobTocompany_job", fields: [reports_to_job_id], references: [id], onUpdate: NoAction, map: "cj_reports_to_fkey")
  other_company_job          company_job[]                @relation("company_jobTocompany_job")
  company_job_qualification  company_job_qualification[]
  company_job_requirement    company_job_requirement[]
  company_job_responsibility company_job_responsibility[]
  employee                   employee[]

  @@index([reports_to_job_id], map: "ix_cj_reports_to")
}

model company_job_qualification {
  id                 Int         @id @default(autoincrement())
  job_id             Int
  qualification_type String      @default("ACADEMIC")
  qualification      String
  description        String?
  priority           String      @default("MANDATORY")
  competency_level   String?
  company_job        company_job @relation(fields: [job_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "cjl_job_fkey")

  @@index([job_id], map: "ix_cjl_job")
}

model company_job_requirement {
  id          Int         @id @default(autoincrement())
  job_id      Int
  line_no     Int         @default(0)
  description String
  company_job company_job @relation(fields: [job_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "cjq_job_fkey")

  @@index([job_id, line_no], map: "ix_cjq_job")
}

model company_job_responsibility {
  id          Int         @id @default(autoincrement())
  job_id      Int
  line_no     Int         @default(0)
  description String
  company_job company_job @relation(fields: [job_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "cjr_job_fkey")

  @@index([job_id, line_no], map: "ix_cjr_job")
}

model config_package {
  id                   Int                    @id @default(autoincrement())
  code                 String                 @unique
  name                 String
  table_name           String
  key_field            String?
  created_at           String?
  created_by           String?
  config_package_field config_package_field[]
}

model config_package_field {
  id             Int            @id @default(autoincrement())
  package_id     Int
  field_name     String
  column_no      Int
  config_package config_package @relation(fields: [package_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([package_id, field_name], map: "ux_config_package_field")
}

model county {
  id         Int          @id @default(autoincrement())
  name       String       @unique
  status     String       @default("ACTIVE")
  code       String?      @unique(map: "ux_county_code")
  employee   employee[]
  sub_county sub_county[]
}

model currency {
  id                                                           Int                      @id @default(autoincrement())
  code                                                         String                   @unique
  description                                                  String
  symbol                                                       String?
  iso_numeric_code                                             String?
  is_base                                                      Int                      @default(0)
  amount_rounding_precision                                    BigInt                   @default(1)
  invoice_rounding_precision                                   BigInt                   @default(0)
  realized_gains_account_id                                    Int?
  realized_losses_account_id                                   Int?
  unrealized_gains_account_id                                  Int?
  unrealized_losses_account_id                                 Int?
  residual_gains_account_id                                    Int?
  residual_losses_account_id                                   Int?
  blocked                                                      Int                      @default(0)
  created_at                                                   String?
  created_by                                                   String?
  gl_account_currency_realized_gains_account_idTogl_account    gl_account?              @relation("currency_realized_gains_account_idTogl_account", fields: [realized_gains_account_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "currency_realized_gains_fkey")
  gl_account_currency_realized_losses_account_idTogl_account   gl_account?              @relation("currency_realized_losses_account_idTogl_account", fields: [realized_losses_account_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "currency_realized_losses_fkey")
  gl_account_currency_residual_gains_account_idTogl_account    gl_account?              @relation("currency_residual_gains_account_idTogl_account", fields: [residual_gains_account_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "currency_residual_gains_fkey")
  gl_account_currency_residual_losses_account_idTogl_account   gl_account?              @relation("currency_residual_losses_account_idTogl_account", fields: [residual_losses_account_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "currency_residual_losses_fkey")
  gl_account_currency_unrealized_gains_account_idTogl_account  gl_account?              @relation("currency_unrealized_gains_account_idTogl_account", fields: [unrealized_gains_account_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "currency_unrealized_gains_fkey")
  gl_account_currency_unrealized_losses_account_idTogl_account gl_account?              @relation("currency_unrealized_losses_account_idTogl_account", fields: [unrealized_losses_account_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "currency_unrealized_losses_fkey")
  currency_exchange_rate                                       currency_exchange_rate[]
}

model currency_exchange_rate {
  id                          Int      @id @default(autoincrement())
  currency_code               String
  starting_date               String
  exchange_rate_amount        Float    @default(1)
  relational_exch_rate_amount Float    @default(1)
  created_at                  String?
  created_by                  String?
  currency                    currency @relation(fields: [currency_code], references: [code], onDelete: Cascade, onUpdate: NoAction, map: "cer_currency_fkey")

  @@unique([currency_code, starting_date], map: "currency_exchange_rate_ccy_date_key")
}

model cust_ledger_entry {
  id                         Int                          @id @default(autoincrement())
  customer_id                Int
  posting_date               String
  document_type              String
  document_no                String
  description                String?
  amount                     BigInt                       @default(0)
  remaining_amount           BigInt                       @default(0)
  original_amount            BigInt                       @default(0)
  due_date                   String?
  pmt_discount_date          String?
  original_pmt_disc_possible BigInt                       @default(0)
  open                       Int                          @default(1)
  positive                   Int                          @default(1)
  closed_by_entry_no         Int?
  closed_at_date             String?
  reminder_level             Int                          @default(0)
  calculate_interest         Int                          @default(0)
  source_type                String?
  source_id                  Int?
  journal_id                 Int?
  created_at                 String?
  currency_code              String                       @default("KES")
  currency_factor            Float                        @default(1)
  amount_lcy                 BigInt                       @default(0)
  remaining_amount_lcy       BigInt                       @default(0)
  original_amount_lcy        BigInt                       @default(0)
  customer                   customer                     @relation(fields: [customer_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "cle_customer_fkey")
  detailed_cust_ledger_entry detailed_cust_ledger_entry[]

  @@index([customer_id, open], map: "ix_cle_customer_open")
  @@index([document_no], map: "ix_cle_document_no")
  @@index([due_date], map: "ix_cle_due_date")
}

model customer {
  id                          Int                     @id @default(autoincrement())
  no                          String                  @unique
  name                        String
  name_2                      String?
  address                     String?
  address_2                   String?
  city                        String?
  post_code                   String?
  country                     String?
  contact                     String?
  phone                       String?
  email                       String?
  customer_posting_group_code String?
  payment_terms_code          String?
  payment_method_code         String?
  reminder_terms_code         String?
  fin_charge_terms_code       String?
  salesperson                 String?
  credit_limit                BigInt                  @default(0)
  blocked                     String                  @default("")
  global_dimension_1_id       Int?
  global_dimension_2_id       Int?
  balance                     BigInt                  @default(0)
  last_statement_no           Int                     @default(0)
  created_at                  String?
  created_by                  String?
  currency_code               String?
