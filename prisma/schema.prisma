  id          Int      @id @default(autoincrement())
  workflow_id Int
  field       String
  operator    String
  value       String
  value2      String?
  workflow    workflow @relation(fields: [workflow_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([workflow_id], map: "ix_condition_workflow")
}

model workflow_step {
  id                Int             @id @default(autoincrement())
  workflow_id       Int
  step_no           Int
  approver_type     String
  approver_user_id  Int?
  approver_group_id Int?
  notify_email      Int             @default(1)
  workflow          workflow        @relation(fields: [workflow_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  workflow_task     workflow_task[]

  @@index([workflow_id, step_no], map: "ix_step_workflow")
}

model workflow_table_relation {
  id                            Int                             @id @default(autoincrement())
  document_type                 String                          @unique
  table_name                    String
  created_at                    String?
  created_by                    String?
  workflow_table_relation_field workflow_table_relation_field[]
}

model workflow_table_relation_field {
  id                      Int                     @id @default(autoincrement())
  table_relation_id       Int
  field_name              String
  workflow_table_relation workflow_table_relation @relation(fields: [table_relation_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([table_relation_id, field_name], map: "ux_table_relation_field")
}

model workflow_task {
  id                   Int                  @id @default(autoincrement())
  workflow_id          Int?
  workflow_step_id     Int?
  step_no              Int
  document_type        String
  entity_id            String
  assigned_to_user_id  Int?
  assigned_to_group_id Int?
  status               String               @default("PENDING")
  requested_by         String
  requested_at         String
  decided_by           String?
  decided_at           String?
  comment              String?
  amount               BigInt               @default(0)
  payload              String?
  current_sequence     Int?
  delegated_by_user_id Int?
  delegated_to_user_id Int?
  workflow_user_group  workflow_user_group? @relation(fields: [assigned_to_group_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  workflow             workflow?            @relation(fields: [workflow_id], references: [id], onUpdate: NoAction)
  workflow_step        workflow_step?       @relation(fields: [workflow_step_id], references: [id], onUpdate: NoAction)

  @@index([assigned_to_user_id], map: "ix_task_assignee")
  @@index([document_type, entity_id], map: "ix_task_document")
  @@index([status], map: "ix_task_status")
}

model workflow_user_group {
  id                         Int                          @id @default(autoincrement())
  name                       String                       @unique
  status                     String                       @default("ACTIVE")
  workflow_task              workflow_task[]
  workflow_user_group_member workflow_user_group_member[]
}

model workflow_user_group_member {
  id                  Int                 @id @default(autoincrement())
  group_id            Int
  user_id             Int
  sequence            Int                 @default(1)
  workflow_user_group workflow_user_group @relation(fields: [group_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  app_user            app_user            @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([group_id, user_id], map: "ux_group_member")
}

/// A sale reported to KRA eTIMS (OSCU) — the outbox: queued when the sale closes, signed when KRA
/// answers. invc_no is the branch's gap-free invoice sequence, given only at transmission.
model etims_invoice {
  id            Int     @id @default(autoincrement())
  source_type   String
  source_no     String
  rcpt_type     String  @default("S")
  org_invc_no   Int?
  invc_no       Int?    @unique
  status        String  @default("PENDING")
  cust_tin      String?
  cust_name     String?
  pmt_type      String
  total         BigInt
  tax_total     BigInt
  payload       Json?
  response      Json?
  attempts      Int     @default(0)
  last_error    String?
  next_attempt_at String?
  cur_rcpt_no   Int?
  tot_rcpt_no   Int?
  intrl_data    String?
  rcpt_sign     String?
  sdc_date_time String?
  sdc_id        String?
  mrc_no        String?
  created_at    String
  created_by    String
  signed_at     String?

  @@unique([source_type, source_no, rcpt_type])
  @@index([status, next_attempt_at])
}

/// Admin-configured integrations (M-Pesa Daraja, outgoing e-mail), one JSON row per key.
/// Secrets inside `value` are AES-256-GCM sealed (lib/fieldCrypto.ts) — never stored in clear.
model integration_setting {
  key        String  @id
  value      Json
  updated_at String
  updated_by String?
}

/// One Lipa na M-Pesa Online (STK push) prompt sent to a client's phone, and what came of it.
model mpesa_request {
  id                  Int     @id @default(autoincrement())
  /// The client paying, and the posted sales invoice the payment is applied to (if any).
  customer_id         Int
  document_no         String?
  environment         String
  phone               String
  amount              BigInt
  account_reference   String
  checkout_request_id String? @unique
  merchant_request_id String?
  status              String  @default("PENDING")
  result_code         Int?
  result_desc         String?
  mpesa_receipt       String? @unique
  paid_amount         BigInt?
  paid_phone          String?
  transaction_date    String?
  journal_no          String?
  requested_by        String
  requested_at        String
  completed_at        String?

  @@index([customer_id])
  @@index([status])
}

/// A physical stock count of one store (BC Phys. Inventory Journal). The system's quantity is
/// snapshotted when the count is opened; posting corrects stock to what was counted and books the
/// difference to the inventory adjustment account.
model stock_count {
  id          Int                @id @default(autoincrement())
  no          String             @unique
  location_id Int
  count_date  String
  status      String             @default("OPEN")
  notes       String?
  total_variance BigInt          @default(0)
  journal_id  Int?
  created_at  String
  created_by  String
  posted_at   String?
  posted_by   String?
  lines       stock_count_line[]
}

model stock_count_line {
  id             Int         @id @default(autoincrement())
  stock_count_id Int
  item_id        Int
  /// On hand per the system when the count opened (base units).
  qty_calculated Int
  /// What was physically counted (base units); null = not counted yet.
  qty_counted    Int?
  /// Value of the difference once posted (cents; negative = shrinkage).
  variance_amount BigInt?
  stock_count    stock_count @relation(fields: [stock_count_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([stock_count_id, item_id])
  @@index([stock_count_id])
}


// ============================================================================================
// Outpatient clinic — patients and their cover, appointments, visits (encounters) and department
// queues, triage, consultations and diagnoses, laboratory, imaging, pharmacy, dental, procedures,
// the charge master and price lists, patient bills, cashier payments, insurance pre-authorisations
// and claims. Foreign keys into the ERP core (gl_account, customer, item, location, bank_account,
// journal, app_user) and between these tables are declared as constraints in the init migration
// rather than as Prisma relations, so the shared models stay untouched; every query is raw SQL.
// Money is integer cents (BIGINT). Dates are 'YYYY-MM-DD' text, timestamps ISO-8601 text.
// ============================================================================================

/// Clinic Setup — singleton (id = 1): posting accounts, cashier defaults and clinical policy.
model clinic_setup {
  id                             Int     @id @default(1)
  /// Patient share of a finalised bill: Dr here, cleared by cashier payments.
  patient_receivable_account_id  Int?
  /// Scheme share of a finalised bill, until the claim is invoiced to the payer in Receivables.
  unbilled_claims_account_id     Int?
  /// Discounts and waivers granted on a bill.
  discount_account_id            Int?
  /// Claim amounts a payer rejects (or a shortfall written off).
  claim_writeoff_account_id      Int?
  /// Fallback revenue account for a service whose category names none.
  default_revenue_account_id     Int?
  cash_bank_account_id           Int?
  mpesa_bank_account_id          Int?
  card_bank_account_id           Int?
  bank_transfer_account_id       Int?
  /// The store drugs and consumables are dispensed from.
  pharmacy_location_id           Int?
  default_price_list_code        String  @default("CASH")
  /// Customer posting group a new insurance scheme's Receivables customer is created in.
  scheme_customer_posting_group  String  @default("INSURANCE")
  /// Registration fee charged on a patient's first visit (0 = none).
  registration_service_code      String?
  /// Cash patients pay before being served (consultation, lab, pharmacy).
  pay_before_service             Int     @default(0)
  /// A lab result must be verified by a second person before it is released.
  lab_requires_verification      Int     @default(1)
  /// Days within which a follow-up visit to the same department is a free review.
  review_window_days             Int     @default(7)
  /// Appointment reminders (SMS) go out this many hours ahead.
  reminder_hours                 Int     @default(24)
  /// Opening hours shown on the booking calendar.
  day_start                      String  @default("08:00")
  day_end                        String  @default("18:00")
  slot_minutes                   Int     @default(20)
  updated_at                     String?
  updated_by                     String?
}

/// A clinic or service point — General OPD, Dental, Laboratory, Imaging, Pharmacy, Nursing, MCH…
model clinic_department {
  id           Int     @id @default(autoincrement())
  code         String  @unique
  name         String
  /// CLINIC (sees patients) | SERVICE (lab, imaging, pharmacy, cashier, triage)
  kind         String  @default("CLINIC")
  queue_prefix String  @default("Q")
  room         String?
  colour       String  @default("#0E7490")
  /// Consultation charge raised when a patient is sent to this clinic (charge master code).
  consultation_service_code String?
  status       String  @default("ACTIVE")
  sort_order   Int     @default(0)
  created_at   String?
  created_by   String?
}

/// Revenue grouping for the charge master — every category credits its own revenue account.
model service_category {
  id                 Int     @id @default(autoincrement())
  code               String  @unique
  name               String
  revenue_account_id Int?
  sort_order         Int     @default(0)
}

/// The charge master (tariff): every billable service, test, procedure and drug.
model service_item {
  id                          Int     @id @default(autoincrement())
  code                        String  @unique
  name                        String
  category_code               String
  /// CONSULTATION | REGISTRATION | LAB | IMAGING | DENTAL | PROCEDURE | NURSING | DRUG | CONSUMABLE | OTHER
  kind                        String  @default("OTHER")
  department_code             String?
  base_price                  BigInt  @default(0)
  /// Drugs and consumables: the inventory item stock is drawn from.
  item_id                     Int?
  vat_prod_posting_group_code String  @default("EXEMPT")
  requires_preauth            Int     @default(0)
  description                 String?
  status                      String  @default("ACTIVE")
  created_at                  String?
  created_by                  String?

  @@index([kind])
}

/// A tariff a visit is priced on — Cash, each insurer's negotiated rates, corporate, staff.
model price_list {
  id          Int     @id @default(autoincrement())
  code        String  @unique
  name        String
  /// CASH | INSURANCE | CORPORATE | STAFF
  kind        String  @default("CASH")
  /// Applied to the charge master base price when the list has no line for a service.
  markup_pct  Decimal @default(0) @db.Decimal(7, 2)
  status      String  @default("ACTIVE")
  created_at  String?
  created_by  String?
}

model price_list_line {
  id              Int    @id @default(autoincrement())
  price_list_code String
  service_item_id Int
  price           BigInt

  @@unique([price_list_code, service_item_id])
}

/// A payer — an insurer, the Social Health Authority, an employer. Billed through its own
/// Receivables customer so claims age, are statemented and are receipted like any debtor.
model insurance_scheme {
  id                     Int     @id @default(autoincrement())
  code                   String  @unique
  name                   String
  /// INSURER | SHA | CORPORATE | GOVERNMENT
  payer_type             String  @default("INSURER")
  customer_id            Int?
  price_list_code        String?
  /// NONE | FIXED | PERCENT — what the member pays at the counter.
  copay_type             String  @default("NONE")
  copay_value            BigInt  @default(0)
  /// Services above this amount on one visit need a pre-authorisation (0 = never).
  preauth_threshold      BigInt  @default(0)
  /// A per-visit cap on what the scheme pays (0 = no cap).
  visit_limit            BigInt  @default(0)
  claim_submission_days  Int     @default(30)
  contact_name           String?
  contact_email          String?
  contact_phone          String?
  status                 String  @default("ACTIVE")
  notes                  String?
  created_at             String?
  created_by             String?
}

/// The patient register. National ID is AES-256-GCM sealed and shown masked.
model patient {
  id                   Int     @id @default(autoincrement())
  mrn                  String  @unique
  title                String?
  first_name           String
  middle_name          String?
  last_name            String
  /// MALE | FEMALE | INTERSEX
  sex                  String
  date_of_birth        String?
  dob_estimated        Int     @default(0)
  marital_status       String?
  id_type              String  @default("NATIONAL_ID")
  id_number_enc        String?
  id_number_last4      String?
  phone                String?
  alt_phone            String?
  email                String?
  address              String?
  county_code          String?
  occupation           String?
  blood_group          String?
  allergies            String?
  chronic_conditions   String?
  /// Clinical alerts shown on every screen the patient appears on.
  alerts               String?
  next_of_kin_name     String?
  next_of_kin_relation String?
  next_of_kin_phone    String?
  photo_url            String?
  /// ACTIVE | INACTIVE | DECEASED
  status               String  @default("ACTIVE")
  sms_consent          Int     @default(1)
  first_visit_date     String?
  last_visit_date      String?
  notes                String?
  created_at           String
  created_by           String
  updated_at           String?
  updated_by           String?

  @@index([last_name, first_name])
  @@index([phone])
}

/// A patient's membership of a scheme.
model patient_cover {
  id             Int     @id @default(autoincrement())
  patient_id     Int
  scheme_id      Int
  member_no      String
  principal_name String?
  /// SELF | SPOUSE | CHILD | DEPENDANT
  relationship   String  @default("SELF")
  valid_from     String?
  valid_to       String?
  is_default     Int     @default(0)
  status         String  @default("ACTIVE")
  created_at     String
  created_by     String

  @@index([patient_id])
}

model appointment {
  id                Int     @id @default(autoincrement())
  no                String  @unique
  patient_id        Int
  department_code   String
  clinician_user_id Int?
  appointment_date  String
  start_time        String
  duration_mins     Int     @default(20)
  /// NEW | REVIEW | PROCEDURE | DENTAL | LAB | VACCINATION
  appointment_type  String  @default("NEW")
  reason            String?
  /// BOOKED | CONFIRMED | ARRIVED | COMPLETED | CANCELLED | NO_SHOW
  status            String  @default("BOOKED")
  /// WALK_IN | PHONE | ONLINE | FOLLOW_UP
  source            String  @default("PHONE")
  visit_id          Int?
  reminder_sent_at  String?
  cancel_reason     String?
  created_at        String
  created_by        String

  @@index([appointment_date])
  @@index([patient_id])
}

/// An outpatient visit (encounter): checked in, triaged, seen, investigated, dispensed, billed.
model visit {
  id                Int     @id @default(autoincrement())
  no                String  @unique
  patient_id        Int
  visit_date        String
  check_in_at       String
  /// NEW | REVISIT | REVIEW | EMERGENCY
  visit_type        String  @default("NEW")
  department_code   String
  clinician_user_id Int?
  /// CASH | INSURANCE | CORPORATE
  payment_mode      String  @default("CASH")
  scheme_id         Int?
  cover_id          Int?
  member_no         String?
  price_list_code   String
  /// ROUTINE | URGENT | EMERGENCY
  priority          String  @default("ROUTINE")
  /// Where the patient is now: TRIAGE | CONSULTATION | INVESTIGATION | PHARMACY | CASHIER | COMPLETED | CANCELLED
  stage             String  @default("TRIAGE")
  /// OPEN | CLOSED | CANCELLED
  status            String  @default("OPEN")
  chief_complaint   String?
  appointment_id    Int?
  referral_source   String?
  /// HOME | FOLLOW_UP | REFERRED | ADMITTED_ELSEWHERE | DECEASED
  outcome           String?
  follow_up_date    String?
  closed_at         String?
  closed_by         String?
  created_at        String
  created_by        String

  @@index([visit_date])
  @@index([patient_id])
  @@index([status])
}

/// A visit's place in a department's queue — one row per service point the patient passes.
model visit_queue {
  id              Int     @id @default(autoincrement())
  visit_id        Int
  department_code String
  queue_no        String
  /// WAITING | CALLED | SERVING | DONE | SKIPPED
  status          String  @default("WAITING")
  priority        String  @default("ROUTINE")
  room            String?
  entered_at      String
  called_at       String?
  served_by       String?
  completed_at    String?

  @@index([department_code, status])
  @@index([visit_id])
}

/// Vital signs and triage category.
model triage {
  id               Int     @id @default(autoincrement())
  visit_id         Int
  temperature_c    Decimal? @db.Decimal(4, 1)
  pulse            Int?
  resp_rate        Int?
  bp_systolic      Int?
  bp_diastolic     Int?
  spo2             Int?
  weight_kg        Decimal? @db.Decimal(5, 1)
  height_cm        Decimal? @db.Decimal(5, 1)
  bmi              Decimal? @db.Decimal(4, 1)
  muac_cm          Decimal? @db.Decimal(4, 1)
  blood_sugar      Decimal? @db.Decimal(4, 1)
  pain_score       Int?
  /// RED | ORANGE | YELLOW | GREEN — Kenya triage acuity
  acuity           String  @default("GREEN")
  notes            String?
  recorded_at      String
  recorded_by      String

  @@index([visit_id])
}

/// A clinician's note on a visit (SOAP). Dental visits add the odontogram and treatment plan.
model consultation {
  id                     Int     @id @default(autoincrement())
  visit_id               Int
  department_code        String
  clinician_user_id      Int
  clinician_name         String
  chief_complaint        String?
  history                String?
  past_history           String?
  family_social_history  String?
  review_of_systems      String?
  examination            String?
  assessment             String?
  plan                   String?
  /// OPEN | COMPLETED
  status                 String  @default("OPEN")
  started_at             String
  completed_at           String?

  @@index([visit_id])
}

/// ICD-10 reference (the common outpatient subset is seeded; more can be added).
model icd_code {
  id       Int     @id @default(autoincrement())
  code     String  @unique
  title    String
  chapter  String?
  common   Int     @default(0)
}

model diagnosis {
  id              Int     @id @default(autoincrement())
  visit_id        Int
  icd_code        String?
  description     String
  /// PRIMARY | SECONDARY | PROVISIONAL
  diagnosis_type  String  @default("PRIMARY")
  created_at      String
  created_by      String

  @@index([visit_id])
}

/// A bill line — every service, test, drug or procedure a visit incurs (the patient's folio).
model patient_charge {
  id              Int     @id @default(autoincrement())
  visit_id        Int
  patient_id      Int
  service_item_id Int?
  /// CONSULTATION | REGISTRATION | LAB | IMAGING | PHARMACY | DENTAL | PROCEDURE | NURSING | MANUAL
  source_type     String
  source_id       Int?
  department_code String?
  description     String
  quantity        Decimal @default(1) @db.Decimal(10, 2)
  unit_price      BigInt
  amount          BigInt
  discount        BigInt  @default(0)
  /// What the scheme pays of this line (insurance visits); the rest is the patient's.
  scheme_amount   BigInt  @default(0)
  /// OPEN | BILLED | CANCELLED
  status          String  @default("OPEN")
  bill_id         Int?
  charged_at      String
  charged_by      String
  cancelled_at    String?
  cancelled_by    String?
  cancel_reason   String?

  @@index([visit_id])
  @@index([bill_id])
}

/// The visit's invoice. Finalising posts revenue; the patient share is collected at the cashier
/// and the scheme share becomes an insurance claim.
model patient_bill {
  id             Int     @id @default(autoincrement())
  no             String  @unique
  visit_id       Int     @unique
  patient_id     Int
  payment_mode   String
  scheme_id      Int?
  bill_date      String
  gross          BigInt  @default(0)
  discount       BigInt  @default(0)
  net            BigInt  @default(0)
  patient_share  BigInt  @default(0)
  scheme_share   BigInt  @default(0)
  /// OPEN | FINAL | CANCELLED
  status         String  @default("OPEN")
  finalised_at   String?
  finalised_by   String?
  journal_id     Int?
  created_at     String
  created_by     String
}

/// Money taken at the cashier — against a visit (deposit) or its bill.
model patient_payment {
  id              Int     @id @default(autoincrement())
  no              String  @unique
  patient_id      Int
  visit_id        Int?
  payment_date    String
  /// CASH | MPESA | CARD | BANK
  method          String
  reference       String?
  amount          BigInt
  bank_account_id Int
  /// POSTED | VOIDED
  status          String  @default("POSTED")
  journal_id      Int?
  received_by     String
  created_at      String
  voided_at       String?
  voided_by       String?
  void_reason     String?
  void_journal_id Int?

  @@index([visit_id])
  @@index([payment_date])
}

model preauthorization {
  id               Int     @id @default(autoincrement())
  no               String  @unique
  scheme_id        Int
  patient_id       Int
  visit_id         Int?
  requested_amount BigInt
  approved_amount  BigInt?
  description      String
  /// REQUESTED | APPROVED | DECLINED | EXPIRED
  status           String  @default("REQUESTED")
  auth_code        String?
  requested_at     String
  requested_by     String
  decided_at       String?
  decided_by       String?
  notes            String?
}

/// The scheme share of a finalised bill, claimed from the payer. Approving it invoices the payer's
/// Receivables customer; a rejected or short-paid amount is written off.
model insurance_claim {
  id              Int     @id @default(autoincrement())
  no              String  @unique
  scheme_id       Int
  patient_id      Int
  visit_id        Int
  bill_id         Int     @unique
  member_no       String?
  preauth_no      String?
  claim_date      String
  amount          BigInt
  approved_amount BigInt?
  /// DRAFT | SUBMITTED | APPROVED | PARTIAL | REJECTED
  status          String  @default("DRAFT")
  batch_ref       String?
  submitted_at    String?
  submitted_by    String?
  decided_at      String?
  decided_by      String?
  rejection_reason String?
  invoice_no      String?
  writeoff_journal_id Int?
  notes           String?
  created_at      String
  created_by      String

  @@index([status])
}

/* ---------------------------------------------------------------- laboratory */

model lab_test {
  id              Int     @id @default(autoincrement())
  code            String  @unique
  name            String
  /// HAEMATOLOGY | BIOCHEMISTRY | MICROBIOLOGY | PARASITOLOGY | SEROLOGY | URINALYSIS | IMMUNOLOGY | HORMONES
  section         String
  /// BLOOD | SERUM | PLASMA | URINE | STOOL | SWAB | SPUTUM | CSF
  specimen_type   String  @default("BLOOD")
  container       String?
  method          String?
  tat_minutes     Int     @default(60)
  service_item_id Int?
  status          String  @default("ACTIVE")
  sort_order      Int     @default(0)
}

model lab_test_parameter {
  id               Int      @id @default(autoincrement())
  lab_test_id      Int
  sort_order       Int      @default(0)
  name             String
  unit             String?
  /// NUMERIC | TEXT | OPTION
  result_type      String   @default("NUMERIC")
  /// OPTION: comma-separated choices; the first is the normal one.
  options          String?
  ref_low          Decimal? @db.Decimal(12, 3)
  ref_high         Decimal? @db.Decimal(12, 3)
  ref_low_female   Decimal? @db.Decimal(12, 3)
  ref_high_female  Decimal? @db.Decimal(12, 3)
  critical_low     Decimal? @db.Decimal(12, 3)
  critical_high    Decimal? @db.Decimal(12, 3)
  ref_text         String?

  @@index([lab_test_id])
}

model lab_order {
  id             Int     @id @default(autoincrement())
  no             String  @unique
  visit_id       Int
  patient_id     Int
  /// ROUTINE | URGENT | STAT
  priority       String  @default("ROUTINE")
  clinical_notes String?
  /// ORDERED | IN_PROGRESS | COMPLETED | CANCELLED
  status         String  @default("ORDERED")
  ordered_at     String
  ordered_by     String

  @@index([visit_id])
  @@index([status])
}

model lab_order_test {
  id           Int     @id @default(autoincrement())
  lab_order_id Int
  lab_test_id  Int
  charge_id    Int?
  /// ORDERED | COLLECTED | RESULTED | VERIFIED | CANCELLED
  status       String  @default("ORDERED")
  specimen_no  String?
  collected_at String?
  collected_by String?
  resulted_at  String?
  resulted_by  String?
  verified_at  String?
  verified_by  String?
  comment      String?

  @@index([lab_order_id])
}

model lab_result {
  id                Int      @id @default(autoincrement())
  order_test_id     Int
  parameter_id      Int
  value_text        String?
  value_num         Decimal? @db.Decimal(12, 3)
  /// N | L | H | LL | HH | A (abnormal text / option)
  flag              String   @default("N")
  created_at        String

  @@unique([order_test_id, parameter_id])
}

/* ---------------------------------------------------------------- imaging */

model imaging_order {
  id              Int     @id @default(autoincrement())
  no              String  @unique
  visit_id        Int
  patient_id      Int
  service_item_id Int
  /// XRAY | ULTRASOUND | OPG | CBCT | ECG | CT | MRI
  modality        String
  body_part       String?
  clinical_notes  String?
  priority        String  @default("ROUTINE")
  /// ORDERED | PERFORMED | REPORTED | CANCELLED
  status          String  @default("ORDERED")
  charge_id       Int?
  ordered_at      String
  ordered_by      String
  performed_at    String?
  performed_by    String?
  findings        String?
  impression      String?
  image_url       String?
  reported_at     String?
  reported_by     String?

  @@index([status])
}

/* ---------------------------------------------------------------- pharmacy */

/// Drug details over an inventory item (stocked, costed FIFO) priced by its charge-master line.
model drug {
  id                Int     @id @default(autoincrement())
  item_id           Int     @unique
  service_item_id   Int?
  generic_name      String
  brand_name        String?
  strength          String?
  /// TABLET | CAPSULE | SYRUP | SUSPENSION | INJECTION | CREAM | OINTMENT | DROPS | INHALER | SUPPOSITORY | MOUTHWASH | GEL
  dosage_form       String  @default("TABLET")
  default_route     String  @default("PO")
  default_frequency String?
  controlled        Int     @default(0)
  status            String  @default("ACTIVE")
}

model prescription {
  id            Int     @id @default(autoincrement())
  no            String  @unique
  visit_id      Int
  patient_id    Int
  /// PENDING | PARTIAL | DISPENSED | CANCELLED
  status        String  @default("PENDING")
  notes         String?
  prescribed_at String
  prescribed_by String

  @@index([status])
  @@index([visit_id])
}

model prescription_line {
  id              Int     @id @default(autoincrement())
  prescription_id Int
  drug_id         Int
  dose            String
  route           String  @default("PO")
  frequency       String
  duration_days   Int     @default(1)
  quantity        Int
  instructions    String?
  dispensed_qty   Int     @default(0)
  /// PENDING | DISPENSED | CANCELLED | OUT_OF_STOCK
  status          String  @default("PENDING")
  charge_id       Int?
  item_journal_no String?
  dispensed_at    String?
  dispensed_by    String?

  @@index([prescription_id])
}

/* ---------------------------------------------------------------- dental */

/// The odontogram: one row per finding on a tooth (FDI numbering). A newer finding on the same
/// tooth supersedes the older one, so the chart is the CURRENT rows and the history is all of them.
model dental_chart_entry {
  id          Int     @id @default(autoincrement())
  patient_id  Int
  visit_id    Int?
  tooth       String
  surfaces    String?
  condition   String
  notes       String?
  /// CURRENT | SUPERSEDED
  status      String  @default("CURRENT")
  recorded_at String
  recorded_by String

  @@index([patient_id, status])
}

model dental_treatment_plan {
  id          Int     @id @default(autoincrement())
  no          String  @unique
  patient_id  Int
  visit_id    Int?
  title       String
  /// PROPOSED | ACCEPTED | IN_PROGRESS | COMPLETED | CANCELLED
  status      String  @default("PROPOSED")
  notes       String?
  accepted_at String?
  created_at  String
  created_by  String

  @@index([patient_id])
}

model dental_treatment_item {
  id                 Int     @id @default(autoincrement())
  plan_id            Int
  tooth              String?
  surfaces           String?
  service_item_id    Int
  description        String
  fee                BigInt
  phase              Int     @default(1)
  /// PLANNED | COMPLETED | CANCELLED
  status             String  @default("PLANNED")
  completed_visit_id Int?
  completed_at       String?
  completed_by       String?
  charge_id          Int?
  notes              String?

  @@index([plan_id])
}

/* ---------------------------------------------------------------- procedures & documents */

/// Minor procedures and nursing services — injections, dressings, suturing, nebulisation, ECG.
model procedure_record {
  id              Int     @id @default(autoincrement())
  visit_id        Int
  patient_id      Int
  service_item_id Int
  description     String
  quantity        Int     @default(1)
  /// ORDERED | DONE | CANCELLED
  status          String  @default("ORDERED")
  charge_id       Int?
  notes           String?
  ordered_at      String
  ordered_by      String
  performed_at    String?
  performed_by    String?

  @@index([status])
}

/// Referral letters and sick-off notes issued from a visit.
model clinical_document {
  id          Int     @id @default(autoincrement())
  no          String  @unique
  visit_id    Int
  patient_id  Int
  /// REFERRAL | SICK_NOTE | MEDICAL_REPORT
  doc_type    String
  referred_to String?
  specialty   String?
  urgency     String?
  from_date   String?
  to_date     String?
  body        String
  issued_at   String
  issued_by   String
}
