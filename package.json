{
  "name": "clinic_erp",
  "version": "1.0.0",
  "description": "Wayside Clinic — outpatient and dental clinic management on an ERP core (finance, HR & payroll, inventory, fixed assets, cash management)",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "node --env-file-if-exists=.env --conditions=react-server --experimental-transform-types test/security.ts",
    "test:security": "node --env-file-if-exists=.env --conditions=react-server --experimental-transform-types test/security.ts",
    "postinstall": "prisma generate",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:studio": "prisma studio",
    "reset": "prisma migrate reset"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "cloudinary": "^2.10.0",
    "exceljs": "^4.4.0",
    "next": "16.4.5",
    "nodemailer": "^10.3.1",
    "pg": "^8.23.0",
    "qrcode": "^1.5.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@types/node": "^24",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.21.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.5",
    "prisma": "^7.9.1",
    "typescript": "^5"
  },
  "packageManager": "pnpm@11.18.0"
}
