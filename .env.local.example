# Copy to .env.local and fill in. Never commit real values.

# PostgreSQL. Behind a pooler (Neon -pooler host) keep DIRECT_DATABASE_URL on the direct host for
# migrations and per-company connections (lib/db.ts).
DATABASE_URL="postgresql://user:password@host/database?sslmode=require"
# DIRECT_DATABASE_URL="postgresql://user:password@direct-host/database?sslmode=require"

# First boot of an EMPTY database (lib/seed.ts):
#   SEED_DEMO_DATA=true   -> the demonstration clinic (patients, a month of visits, lab, pharmacy, dental, bills, claims, demo staff)
#   SEED_DEMO_DATA=false  -> setup data only; demo staff disabled; the administrator gets
#                            ADMIN_INITIAL_PASSWORD and must change it on first sign-in
# Default: demo data unless NODE_ENV=production.
# SEED_DEMO_DATA=false
# The System Administrator's sign-in (default username: admin). Usernames are case-sensitive.
# ADMIN_INITIAL_USERNAME=
# ADMIN_INITIAL_PASSWORD=change-me-on-first-sign-in

# Encrypts patient ID numbers and integration secrets at rest (AES-256-GCM, lib/fieldCrypto.ts). REQUIRED in
# production — those cannot be saved or read without it. 32 random bytes, base64:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Changing it makes every stored ID number unreadable; rotate by re-encrypting, never by swapping.
# FIELD_ENCRYPTION_KEY=

# Encrypts users' authenticator secrets at rest (lib/totp.ts). Any long random string; changing it
# invalidates every enrolment. Unset = derived from DATABASE_URL (works, but not a secret).
# TOTP_ENCRYPTION_KEY=

# A signed-in session unused for this long is refused (lib/auth.ts). 0 disables the idle check.
# SESSION_IDLE_MINUTES=120

# Staff photos, signatures, register documents and attachments
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# CLOUDINARY_FOLDER=wayside_clinic

# Email — set up in the app under Admin Centre → Integrations → Email & Notifications (Gmail or
# Resend; the credential is encrypted with FIELD_ENCRYPTION_KEY). These are only the fallback used
# until that is switched on; with neither, messages wait in the Message Outbox.
# RESEND_API_KEY=
# RESEND_FROM_EMAIL=accounts@waysideclinic.co.ke
# APP_URL=https://app.waysideclinic.co.ke

# M-Pesa (Daraja STK push) — set up in the app under Admin Centre → Integrations → M-Pesa.
# Optional: only accept payment callbacks from these source addresses (Safaricom publishes them).
# MPESA_ALLOWED_IPS=196.201.214.200,196.201.214.206

# SMS (lib/sms.ts) — logs instead of sending when unset
# SMS_GATEWAY_URL=
# SMS_API_KEY=
# SMS_COUNTRY_CODE=254
# SMS_SENDER_ID=WAYSIDE

# Live HTTP probes in the security suite (pnpm test:security) — the address of a running server
# BASE_URL=http://localhost:3000
